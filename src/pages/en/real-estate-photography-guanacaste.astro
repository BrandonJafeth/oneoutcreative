---
import Layout from '../../layouts/Layout.astro';
import CtaFooter from '../../components/CtaFooter.astro';

const HERO_BG = 'https://res.cloudinary.com/dxrzwnjee/image/upload/v1779757053/eqgwgqqqzmhlwj4vpofu.avif';

const included = [
  {
    n: '01',
    title: 'Interior & Exterior Photography',
    desc: 'Full property shoot optimized for listing sites, social media, and printed brochures. Every room, every angle, in the best available natural light.',
    tag: 'Photos',
  },
  {
    n: '02',
    title: 'Aerial Drone Video & Stills',
    desc: 'Cinematic 4K drone footage showcasing location, lot size, ocean views, and surroundings. FAA-equivalent certified pilot. Available across all Guanacaste.',
    tag: '4K · Drone',
  },
  {
    n: '03',
    title: 'Video Walkthrough',
    desc: 'Smooth interior walkthrough video edited for YouTube, MLS listings, and social media reels. Ideal for international buyers who cannot visit the property in person.',
    tag: 'Video',
  },
  {
    n: '04',
    title: '48h Delivery',
    desc: 'Edited photos and video delivered within 48 hours. Rush delivery available. All files web-optimized and print-ready.',
    tag: 'Fast turnaround',
  },
];

const zones = ['Nosara', 'Tamarindo', 'Playa Flamingo', 'Sámara', 'Santa Cruz', 'Nicoya', 'Playa del Coco', 'Papagayo'];

// TODO: Replace with additional property photos from your Cloudinary account
const gallery = [
  {
    src: 'https://res.cloudinary.com/dxrzwnjee/image/upload/c_fill,w_800,h_1100,g_auto/v1779830312/nvloibahw7ybvwbuqcyx.avif',
    alt: 'Luxury villa interior photography Guanacaste Costa Rica',
    span: 'tall',
  },
  {
    src: 'https://res.cloudinary.com/dxrzwnjee/image/upload/c_fill,w_800,h_520,g_auto/v1779757053/eqgwgqqqzmhlwj4vpofu.avif',
    alt: 'Aerial drone photography Guanacaste property',
    span: 'wide',
  },
  {
    src: 'https://res.cloudinary.com/dxrzwnjee/image/upload/c_fill,w_800,h_520,g_south,y_100/v1779830312/nvloibahw7ybvwbuqcyx.avif',
    alt: 'Real estate photography Costa Rica coastal property',
    span: 'wide',
  },
];

const testimonial = {
  quote: 'One Out Creative transformed how I present my listings. My Tamarindo condo sold in 11 days — the drone footage was what got buyers flying in from the States.',
  name: 'Adriana Fonseca',
  role: 'Real Estate Agent · Century 21 Guanacaste',
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://oneoutcr.net/en/real-estate-photography-guanacaste#service",
      "name": "Real Estate Photography & Drone Video — Guanacaste, Costa Rica",
      "description": "Professional real estate photography and cinematic drone video for properties in Nosara, Tamarindo, Playa Flamingo, and the entire Guanacaste coast. Interior/exterior photography, aerial drone stills and video, and video walkthroughs. 48h delivery.",
      "provider": { "@id": "https://oneoutcr.net/#organization" },
      "areaServed": [
        { "@type": "City", "name": "Nosara", "addressCountry": "CR" },
        { "@type": "City", "name": "Tamarindo", "addressCountry": "CR" },
        { "@type": "City", "name": "Playa Flamingo", "addressCountry": "CR" },
        { "@type": "City", "name": "Sámara", "addressCountry": "CR" },
        { "@type": "AdministrativeArea", "name": "Guanacaste", "addressCountry": "CR" }
      ],
      "serviceType": "Real Estate Photography",
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does real estate photography in Guanacaste cost?",
          "acceptedAnswer": { "@type": "Answer", "text": "Pricing varies based on property size and whether drone video is included. Contact us via WhatsApp for a personalized quote — we respond within a few hours." }
        },
        {
          "@type": "Question",
          "name": "Do you cover drone photography in Nosara and Tamarindo?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We provide drone photography and video across all of Guanacaste including Nosara, Tamarindo, Playa Flamingo, Sámara, Santa Cruz, and Papagayo." }
        },
        {
          "@type": "Question",
          "name": "How fast do you deliver the photos and videos?",
          "acceptedAnswer": { "@type": "Answer", "text": "Standard delivery is within 48 hours. Rush delivery (24h) is available for time-sensitive listings." }
        }
      ]
    }
  ]
});
---
<Layout
  title="Real Estate Photography & Drone Video in Guanacaste, Costa Rica | One Out Creative"
  description="Professional real estate photography and cinematic drone video in Guanacaste, Costa Rica. Serving Nosara, Tamarindo, Playa Flamingo, Sámara, and Santa Cruz. 48h delivery."
  lang="en"
  hreflangEn="https://oneoutcr.net/en/real-estate-photography-guanacaste"
  schema={schema}
>
  <!-- Minimal nav -->
  <nav style="position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 0 24px; height: 68px; display: flex; align-items: center; justify-content: space-between; background: rgba(10,10,10,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--hairline);">
    <a href="/en/" style="text-decoration: none; display: flex; align-items: center; gap: 10px;">
      <img
        src="https://res.cloudinary.com/dkwvaxxdw/image/upload/c_pad,b_rgb:0a0a0a,w_140,h_36,f_png,q_auto/v1779290752/Logo_blanco_1_kintyq.png"
        alt="One Out Creative"
        width="112"
        height="28"
        loading="eager"
        style="height: 28px; width: auto;"
      />
    </a>
    <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.78rem;">
      Get a Free Quote
    </a>
  </nav>

  <main id="top">

    <!-- ── HERO ───────────────────────────────────────────────────── -->
    <section style="position: relative; min-height: 94vh; display: flex; align-items: flex-end; padding: clamp(120px, 15vh, 160px) 24px clamp(72px, 10vh, 100px); overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; inset: 0; z-index: 1;">
        <img
          src={HERO_BG}
          alt=""
          fetchpriority="high"
          decoding="async"
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.5;"
        />
        <!-- Gradient: dark bottom for text legibility, lighter at top -->
        <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,10,10,0.55) 0%, rgba(10,10,10,0.2) 40%, rgba(10,10,10,0.85) 100%);"></div>
      </div>

      <div style="position: relative; z-index: 3; max-width: 1200px; margin: 0 auto; width: 100%;">
        <div class="reveal-hidden delay-0" style="margin-bottom: 24px;">
          <div class="eyebrow accent"><span class="dot"></span>Real Estate Photography · Guanacaste, CR</div>
        </div>

        <h1 style="font-family: var(--font-heading); font-size: clamp(3.2rem, 9vw, 7.5rem); line-height: 0.92; letter-spacing: 0.02em; text-transform: uppercase; color: #fff; margin: 0; max-width: 960px;">
          <span class="reveal-hidden delay-1" style="display: block;">YOUR PROPERTY.</span>
          <span class="reveal-hidden delay-2" style="display: block;">ITS BEST</span>
          <span class="reveal-hidden delay-3" style="display: block; color: var(--accent); text-shadow: 0 2px 40px rgba(232,119,34,0.4);">FIRST IMPRESSION.</span>
        </h1>

        <div class="reveal-hidden delay-4" style="margin-top: 28px; max-width: 520px; display: flex; gap: 40px; flex-wrap: wrap; align-items: flex-start;">
          <p style="font-weight: 300; font-size: 1.05rem; line-height: 1.7; color: rgba(255,255,255,0.82); font-family: var(--font-body); flex: 1; min-width: 240px;">
            Professional photography &amp; cinematic drone video for properties across the Guanacaste coast.
            Nosara, Tamarindo, Playa Flamingo, and beyond.
          </p>
        </div>

        <div class="reveal-hidden delay-5" style="display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; align-items: center;">
          <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            Book a Shoot
          </a>
          <a href="#what-is-included" class="btn-ghost liquid-glass-strong" style="color: #fff;">See what's included ↓</a>
          <span style="font-family: var(--font-body); font-size: 0.78rem; color: rgba(255,255,255,0.45); letter-spacing: 0.04em;">Trusted by 30+ agents across Guanacaste</span>
        </div>
      </div>
    </section>

    <!-- ── TRUST BAR ──────────────────────────────────────────────── -->
    <section style="background: var(--card); padding: 28px 24px; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline);">
      <div style="max-width: 1000px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 32px 56px; text-align: center;">
        {[
          { val: '48h', label: 'Photo delivery' },
          { val: '4K', label: 'Drone video' },
          { val: 'EN/ES', label: 'Bilingual team' },
          { val: '5+', label: 'Years in Guanacaste' },
        ].map((s) => (
          <div>
            <div style="font-family: var(--font-heading); font-size: 1.8rem; color: var(--accent); line-height: 1; letter-spacing: 0.01em;">{s.val}</div>
            <div style="margin-top: 4px; font-size: 0.78rem; color: var(--muted); font-family: var(--font-body); font-weight: 300; letter-spacing: 0.05em; text-transform: uppercase;">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── PHOTO PROOF STRIP ──────────────────────────────────────── -->
    <div style="display: grid; grid-template-columns: 1.4fr 1fr 0.9fr; height: clamp(240px, 32vw, 400px); overflow: hidden;">
      <div style="overflow: hidden; position: relative;">
        <img
          src="https://res.cloudinary.com/dxrzwnjee/image/upload/c_fill,w_900,h_500,g_auto/v1779830312/nvloibahw7ybvwbuqcyx.avif"
          alt="Interior real estate photography Guanacaste"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;"
          class="photo-strip-img"
        />
        <div style="position: absolute; bottom: 16px; left: 16px; font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.6); background: rgba(10,10,10,0.55); backdrop-filter: blur(8px); padding: 5px 10px; border-radius: 4px;">Interior</div>
      </div>
      <div style="overflow: hidden; border-left: 3px solid var(--bg); position: relative;">
        <img
          src="https://res.cloudinary.com/dxrzwnjee/image/upload/c_fill,w_700,h_500,g_auto/v1779757053/eqgwgqqqzmhlwj4vpofu.avif"
          alt="Aerial drone photography Guanacaste Costa Rica"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;"
          class="photo-strip-img"
        />
        <div style="position: absolute; bottom: 16px; left: 16px; font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.6); background: rgba(10,10,10,0.55); backdrop-filter: blur(8px); padding: 5px 10px; border-radius: 4px;">Aerial Drone</div>
      </div>
      <div style="overflow: hidden; border-left: 3px solid var(--bg); position: relative;">
        <img
          src="https://res.cloudinary.com/dxrzwnjee/image/upload/c_fill,w_600,h_500,g_south/v1779830312/nvloibahw7ybvwbuqcyx.avif"
          alt="Property video walkthrough real estate Nosara"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;"
          class="photo-strip-img"
        />
        <div style="position: absolute; bottom: 16px; left: 16px; font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.6); background: rgba(10,10,10,0.55); backdrop-filter: blur(8px); padding: 5px 10px; border-radius: 4px;">Walkthrough</div>
      </div>
    </div>

    <!-- ── WHAT'S INCLUDED ────────────────────────────────────────── -->
    <section id="what-is-included" style="background: var(--bg); padding: clamp(72px, 10vw, 120px) 24px;">
      <div style="max-width: 1100px; margin: 0 auto;">
        <div class="reveal-hidden delay-0" style="margin-bottom: 64px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-end; justify-content: space-between;">
          <div>
            <div class="eyebrow"><span class="dot"></span>What's included</div>
            <h2 class="sec-heading" style="margin-top: 14px; max-width: 600px;">One shoot.<br/>Every asset.</h2>
          </div>
          <p style="font-weight: 300; color: var(--muted); font-size: 1.05rem; line-height: 1.65; max-width: 380px; font-family: var(--font-body);">
            From listing photos to social reels to drone footage — all delivered within 48 hours.
          </p>
        </div>

        <!-- Editorial numbered list -->
        <div>
          {included.map((item, i) => (
            <div class="reveal-hidden delay-0" style={`display: grid; grid-template-columns: 80px 1fr auto; gap: 32px 40px; align-items: start; padding: 40px 0; border-top: 1px solid var(--hairline); ${i === included.length - 1 ? 'border-bottom: 1px solid var(--hairline);' : ''}`}>
              <div style="font-family: var(--font-heading); font-size: 4.5rem; color: var(--accent); opacity: 0.18; line-height: 0.85; letter-spacing: -0.02em; user-select: none;">{item.n}</div>
              <div>
                <h3 style="font-family: var(--font-heading); font-size: 1.7rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--fg); margin: 0 0 16px; line-height: 1.05;">{item.title}</h3>
                <p style="font-weight: 300; font-size: 0.97rem; line-height: 1.75; color: var(--muted); font-family: var(--font-body); margin: 0; max-width: 540px;">{item.desc}</p>
              </div>
              <div style="padding-top: 4px;">
                <span style="font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); border: 1px solid rgba(232,119,34,0.3); padding: 5px 12px; border-radius: 9999px; white-space: nowrap;">{item.tag}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── GALLERY ────────────────────────────────────────────────── -->
    <section style="background: var(--card); padding: clamp(72px, 10vw, 120px) 24px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div class="reveal-hidden delay-0" style="margin-bottom: 48px;">
          <div class="eyebrow"><span class="dot"></span>Sample work</div>
          <h2 class="sec-heading" style="margin-top: 14px;">What your listing<br/>could look like.</h2>
        </div>

        <!-- Asymmetric grid: tall left + 2 stacked right -->
        <div style="display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: auto; gap: 12px; max-width: 1200px;">
          <div class="reveal-hidden delay-0" style="grid-row: 1 / 3; border-radius: 1rem; overflow: hidden; aspect-ratio: 3/4;">
            <img
              src={gallery[0].src}
              alt={gallery[0].alt}
              loading="lazy"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; display: block;"
              class="gallery-img"
            />
          </div>
          <div class="reveal-hidden delay-1" style="border-radius: 1rem; overflow: hidden; aspect-ratio: 16/9;">
            <img
              src={gallery[1].src}
              alt={gallery[1].alt}
              loading="lazy"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; display: block;"
              class="gallery-img"
            />
          </div>
          <div class="reveal-hidden delay-2" style="border-radius: 1rem; overflow: hidden; aspect-ratio: 16/9;">
            <img
              src={gallery[2].src}
              alt={gallery[2].alt}
              loading="lazy"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; display: block;"
              class="gallery-img"
            />
          </div>
        </div>

        <div class="reveal-hidden delay-1" style="margin-top: 32px; text-align: center;">
          <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-ghost liquid-glass" style="display: inline-flex;">
            See full portfolio via WhatsApp →
          </a>
        </div>
      </div>
    </section>

    <!-- ── WHY IT MATTERS ─────────────────────────────────────────── -->
    <section style="background: var(--bg); padding: clamp(72px, 10vw, 120px) 24px;">
      <div style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
        <div class="reveal-hidden delay-0">
          <div class="eyebrow"><span class="dot"></span>Why it matters</div>
          <h2 class="sec-heading" style="margin-top: 14px;">Buyers decide in seconds.</h2>
          <p style="font-weight: 300; color: var(--muted); font-size: 1.05rem; line-height: 1.75; margin-top: 24px; font-family: var(--font-body);">
            Most buyers browsing Nosara or Tamarindo listings are doing so from abroad. Their first impression
            of your property happens on a screen — before they ever set foot in Costa Rica.
          </p>

          <!-- Stat callout -->
          <div style="margin-top: 36px; padding: 28px 32px; border-left: 3px solid var(--accent); background: rgba(232,119,34,0.06); border-radius: 0 0.75rem 0.75rem 0;">
            <div style="font-family: var(--font-heading); font-size: clamp(2.4rem, 4vw, 3.2rem); color: var(--fg); line-height: 0.95; letter-spacing: 0.01em;">61%</div>
            <div style="font-family: var(--font-body); font-size: 0.9rem; color: var(--muted); margin-top: 8px; line-height: 1.5;">more page views for listings with professional photography<br/><span style="font-size: 0.78rem; opacity: 0.6;">— National Association of Realtors</span></div>
          </div>

          <p style="font-weight: 300; color: var(--muted); font-size: 1.05rem; line-height: 1.75; margin-top: 28px; font-family: var(--font-body);">
            We understand the Guanacaste market, the light at golden hour on the Pacific coast, and
            what international buyers need to see to make a decision.
          </p>
          <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary" style="display: inline-flex; margin-top: 32px;">
            Book a shoot
          </a>
        </div>
        <div class="reveal-hidden delay-1" style="aspect-ratio: 4/5; border-radius: 1rem; overflow: hidden;">
          <img
            src="https://res.cloudinary.com/dxrzwnjee/image/upload/v1779830312/nvloibahw7ybvwbuqcyx.avif"
            alt="Real estate photography Guanacaste Costa Rica"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: 100%; object-fit: cover;"
          />
        </div>
      </div>
    </section>

    <!-- ── TESTIMONIAL ────────────────────────────────────────────── -->
    <section style="background: var(--card); padding: clamp(72px, 10vw, 120px) 24px;">
      <div style="max-width: 820px; margin: 0 auto; text-align: center;">
        <div class="reveal-hidden delay-0">
          <!-- Large decorative quote mark -->
          <div aria-hidden="true" style="font-family: var(--font-heading); font-size: 8rem; color: var(--accent); opacity: 0.15; line-height: 0.6; margin-bottom: 24px; user-select: none;">"</div>
          <blockquote style="font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.4rem); text-transform: uppercase; letter-spacing: 0.02em; color: var(--fg); line-height: 1.15; margin: 0;">
            {testimonial.quote}
          </blockquote>
          <div style="margin-top: 32px; display: flex; flex-direction: column; align-items: center; gap: 4px;">
            <div style="width: 40px; height: 2px; background: var(--accent); margin-bottom: 16px;"></div>
            <div style="font-family: var(--font-body); font-size: 0.95rem; font-weight: 500; color: var(--fg);">{testimonial.name}</div>
            <div style="font-family: var(--font-body); font-size: 0.82rem; color: var(--muted); letter-spacing: 0.03em;">{testimonial.role}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── ZONES WE SERVE ─────────────────────────────────────────── -->
    <section style="background: var(--bg); padding: clamp(72px, 10vw, 120px) 24px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;">
          <div class="reveal-hidden delay-0">
            <div class="eyebrow"><span class="dot"></span>Coverage area</div>
            <h2 class="sec-heading" style="margin-top: 14px;">We go where<br/>your property is.</h2>
            <p style="font-weight: 300; color: var(--muted); font-size: 1.05rem; line-height: 1.65; margin-top: 24px; font-family: var(--font-body);">
              Based in Nicoya, we cover the entire Guanacaste province. No travel surcharge for most zones.
            </p>
            <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary" style="display: inline-flex; margin-top: 32px;">
              Check your zone →
            </a>
          </div>
          <div class="reveal-hidden delay-1">
            <div style="display: flex; flex-direction: column; gap: 3px;">
              {zones.map((z, i) => (
                <div style={`display: flex; align-items: center; gap: 16px; padding: 16px 20px; border-radius: 0.6rem; ${i % 2 === 0 ? 'background: rgba(255,255,255,0.03);' : ''}`}>
                  <div style="width: 6px; height: 6px; border-radius: 9999px; background: var(--accent); flex-shrink: 0;"></div>
                  <span style="font-family: var(--font-body); font-size: 1rem; color: var(--fg); font-weight: 300;">{z}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FAQ ────────────────────────────────────────────────────── -->
    <section style="background: var(--card); padding: clamp(72px, 10vw, 120px) 24px;">
      <div style="max-width: 780px; margin: 0 auto;">
        <div class="reveal-hidden delay-0" style="margin-bottom: 48px; text-align: center;">
          <div class="eyebrow"><span class="dot"></span>Common questions</div>
          <h2 class="sec-heading" style="margin-top: 14px;">FAQ</h2>
        </div>
        <div style="display: flex; flex-direction: column; gap: 2px;">
          {[
            { q: 'How much does real estate photography in Guanacaste cost?', a: 'Pricing varies based on property size and whether drone video is included. Contact us via WhatsApp for a personalized quote — we respond within a few hours.' },
