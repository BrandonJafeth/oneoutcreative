---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Clientes from '../../components/Clientes.astro';
import ServiciosSplit from '../../components/ServiciosSplit.astro';
import ComoFunciona from '../../components/ComoFunciona.astro';
import FeaturesGrid from '../../components/FeaturesGrid.astro';
import Testimonios from '../../components/Testimonios.astro';
import FAQ from '../../components/FAQ.astro';
import CtaFooter from '../../components/CtaFooter.astro';

import enFaqs from '../../data/en/faqs.json';
import enPasos from '../../data/en/pasos.json';
import enFeatures from '../../data/en/features.json';
import enServicios from '../../data/en/servicios.json';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": enFaqs.map(f => ({
    "@type": "Question",
    "name": f.pregunta,
    "acceptedAnswer": { "@type": "Answer", "text": f.respuesta }
  }))
});
---
<Layout
  title="One Out Creative | Photo, Video & Social Media in Guanacaste, Costa Rica"
  description="Creative agency based in Guanacaste, Costa Rica. Professional photography, drone video, wedding coverage, and social media management for expats and businesses in Tamarindo, Nosara, and the Pacific coast."
  lang="en"
  hreflangEs="https://oneoutcr.net/"
  hreflangEn="https://oneoutcr.net/en/"
  schema={faqSchema}
>
  <Navbar lang="en" />
  <main>
    <Hero
      eyebrow="Creative Agency · Guanacaste, Costa Rica"
      line1="PHOTO & VIDEO"
      line2="GUANACASTE"
      line3="COSTA RICA."
      subtitle="Your brand built to dominate. Photography, drone video, social media, and web for businesses and property owners across Tamarindo, Nosara, Sámara, Playa Flamingo, and the entire Pacific coast."
      ctaText="Message us on WhatsApp"
      ctaSecondaryText="See Testimonials"
      ctaSecondaryHref="#testimonios"
    />
    <Clientes />
    <ServiciosSplit
      data={enServicios}
      eyebrow="What we do"
      heading="Everything your brand needs"
      subtext="Top-tier visual content and marketing as the core focus, backed by optimized websites and memorable brand design."
    />
    <ComoFunciona
      data={enPasos}
      eyebrow="Our Process"
      heading="From idea<br /> to results"
      subtext="A clear process, no surprises. You know exactly what happens at every stage, with deliverables and metrics in plain sight."
    />
    <FeaturesGrid
      data={enFeatures}
      label="WHAT WE DO"
      heading="EVERYTHING YOUR BUSINESS NEEDS"
      subtext="Integrated services so your brand grows consistently and measurably."
    />
    <Testimonios
      label="What our clients say"
      heading="Results that speak for themselves"
    />
    <FAQ
      items={enFaqs}
      label="FREQUENTLY ASKED QUESTIONS"
      heading="WHAT PEOPLE ASK US MOST"
    />
    <CtaFooter lang="en" />
  </main>
</Layout>
