---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import CtaFooter from '../../components/CtaFooter.astro';

const VIDEO_MP4 = 'https://res.cloudinary.com/dkwvaxxdw/video/upload/v1779291255/8126637-hd_1920_1080_25fps_knqueu.mp4';
const HERO_POSTER = 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_1920/v1779291512/pexels-silverkblack-36697542_gbzfwm.jpg';

const services = [
  {
    eyebrow: 'Weddings & Events',
    title: 'Your wedding, captured for life.',
    body: 'Destination weddings, elopements, beach ceremonies, and private events across Tamarindo, Nosara, Sámara, and Playa Flamingo. Photography and video packages.',
    href: '/en/wedding-photography-guanacaste',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`,
  },
  {
    eyebrow: 'Real Estate',
    title: 'Sell properties faster with great visuals.',
    body: 'Professional interior/exterior photography and cinematic drone video for properties in Nosara, Tamarindo, Playa Flamingo, and the Guanacaste coast. Delivered within 48h.',
    href: '/en/real-estate-photography-guanacaste',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
  },
  {
    eyebrow: 'Social Media',
    title: 'Content that builds your brand every week.',
    body: 'Monthly social media management for hotels, restaurants, tour operators, and local businesses. Strategy, content creation, reels, and community management in English and Spanish.',
    href: '/marketing',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>`,
  },
];

const stats = [
  { val: '300%', label: 'Average growth in first 6 months' },
  { val: '5+', label: 'Years serving Guanacaste businesses' },
  { val: '48h', label: 'Standard photo delivery turnaround' },
  { val: 'ES/EN', label: 'Fully bilingual team' },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you work with English-speaking clients in Costa Rica?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We are fully bilingual and regularly work with expats, property owners, hotels, tour operators, and international businesses across Guanacaste, Costa Rica." }
    },
    {
      "@type": "Question",
      "name": "Do you cover weddings in Tamarindo and Nosara?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We cover weddings, elopements, and events throughout all of Guanacaste — Tamarindo, Nosara, Sámara, Playa Flamingo, Santa Cruz, and beyond." }
    },
    {
      "@type": "Question",
      "name": "How much does real estate photography in Guanacaste cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on property size and whether drone video is included. Contact us via WhatsApp for a custom quote — we typically respond within a few hours." }
    },
    {
      "@type": "Question",
      "name": "Do you manage social media for hotels and restaurants in Costa Rica?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. We offer monthly social media management packages that include strategy, content creation, reels, and community management in both English and Spanish." }
    }
  ]
});
---
<Layout
  title="One Out Creative | Photo, Video & Social Media in Guanacaste, Costa Rica"
  description="Creative agency based in Guanacaste, Costa Rica. Professional photography, drone video, wedding coverage, and social media management for expats and businesses in Tamarindo, Nosara, and the Pacific coast."
  lang="en"
  hreflangEs="https://oneoutcr.net/"
  hreflangEn="https://oneoutcr.net/en/"
  schema={faqSchema}
>
  <Navbar />
  <main>

    <!-- ── HERO ───────────────────────────────────────────────────── -->
    <section style="position: relative; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: clamp(120px, 15vh, 160px) 0 clamp(120px, 20vh, 160px); overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; inset: 0; z-index: 1;">
        <video autoplay muted loop playsinline preload="none" poster={HERO_POSTER} aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.4;">
          <source src={VIDEO_MP4} type="video/mp4" />
        </video>
        <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,10,10,0.3) 0%, rgba(10,10,10,0.95) 100%);"></div>
        <div style="position: absolute; inset: 0; background: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 28px 28px;"></div>
      </div>

      <div style="position: relative; z-index: 3; text-align: center; padding: 0 24px; max-width: 1200px; margin: 0 auto; width: 100%;">
        <div class="reveal-hidden delay-0" style="margin-bottom: 28px;">
          <div class="eyebrow accent" style="justify-content: center;">
            <span class="dot"></span>Creative Agency · Guanacaste, Costa Rica
          </div>
        </div>

        <h1 style="font-family: var(--font-heading); font-size: clamp(3.5rem, 9vw, 7.5rem); line-height: 0.95; letter-spacing: 0.02em; text-transform: uppercase; color: #fff; margin: 0;">
          <span style="display: block; overflow: hidden;">
            <span class="reveal-hidden delay-1" style="display: inline-block; color: #fff; text-shadow: 0 2px 30px rgba(0,0,0,0.35);">PHOTO & VIDEO</span>
          </span>
          <span style="display: block; overflow: hidden;">
            <span class="reveal-hidden delay-2" style="display: inline-block; color: #fff; text-shadow: 0 2px 30px rgba(0,0,0,0.35);">GUANACASTE</span>
          </span>
          <span style="display: block; overflow: hidden;">
            <span class="reveal-hidden delay-3" style="display: inline-block; color: var(--accent); text-shadow: 0 2px 30px rgba(232,119,34,0.35);">COSTA RICA.</span>
          </span>
        </h1>

        <div class="reveal-hidden delay-4">
          <p style="font-weight: 300; font-size: 1.05rem; line-height: 1.65; color: rgba(255,255,255,0.78); max-width: 600px; margin: 24px auto 0; font-family: var(--font-body); text-shadow: 0 1px 12px rgba(0,0,0,0.4);">
            Photography, drone video, weddings, and social media for businesses and property owners
            across Tamarindo, Nosara, Sámara, Playa Flamingo, and the entire Pacific coast.
          </p>
        </div>

        <div class="reveal-hidden delay-5" style="display: inline-flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; justify-content: center;">
          <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            Get a Free Quote
          </a>
          <a href="#services" class="btn-ghost liquid-glass-strong" style="color: #fff;">See Our Work</a>
        </div>
      </div>

      <div style="position: absolute; bottom: clamp(20px, 4vh, 40px); left: 50%; transform: translateX(-50%); z-index: 3; text-align: center;">
        <div style="font-size: 0.58rem; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(255,255,255,0.45); margin-bottom: 10px; font-family: var(--font-body);">Scroll</div>
        <div style="background: rgba(255,255,255,0.18); width: 1px; height: 32px; overflow: hidden; position: relative; margin: 0 auto;">
          <span class="scroll-anim" style="display: block; width: 100%; height: 100%; background: #fff;"></span>
        </div>
      </div>
    </section>

    <!-- ── SERVICES ───────────────────────────────────────────────── -->
    <section id="services" style="background: var(--card); padding: clamp(60px, 10vw, 120px) 24px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div class="reveal-hidden delay-0" style="margin-bottom: 56px; text-align: center;">
          <div class="eyebrow"><span class="dot"></span>What we do</div>
          <h2 class="sec-heading" style="margin-top: 14px;">Everything your brand needs</h2>
          <p style="font-weight: 300; color: var(--muted); font-size: 1.05rem; line-height: 1.65; max-width: 560px; margin: 24px auto 0; font-family: var(--font-body);">
            From drone shots to monthly social media — one creative team that knows Guanacaste.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
          {services.map((s) => (
            <div class="reveal-hidden delay-0">
              <a href={s.href} class="liquid-glass" style="display: block; padding: 2rem; border-radius: 1rem; text-decoration: none; height: 100%; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                <div style="color: var(--accent); margin-bottom: 20px;" set:html={s.icon} />
                <div class="eyebrow accent" style="margin-bottom: 12px;">{s.eyebrow}</div>
                <h3 style="font-family: var(--font-heading); font-size: clamp(1.5rem, 2.5vw, 2rem); text-transform: uppercase; letter-spacing: 0.01em; color: var(--fg); margin: 0 0 16px; line-height: 1.1;">{s.title}</h3>
                <p style="font-weight: 300; font-size: 0.95rem; line-height: 1.7; color: var(--muted); font-family: var(--font-body); margin: 0;">{s.body}</p>
                <div style="margin-top: 24px; display: flex; align-items: center; gap: 6px; color: var(--accent); font-size: 0.82rem; font-weight: 500; font-family: var(--font-body); letter-spacing: 0.06em; text-transform: uppercase;">
                  Learn more
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── STATS ──────────────────────────────────────────────────── -->
    <section style="background: var(--bg); padding: clamp(60px, 10vw, 120px) 24px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2px; border: 1px solid var(--hairline); border-radius: 1rem; overflow: hidden;">
          {stats.map((s) => (
            <div class="reveal-hidden delay-0 liquid-glass" style="padding: 2.5rem 2rem; text-align: center;">
              <div style="font-family: var(--font-heading); font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--accent); line-height: 1; letter-spacing: 0.01em;">{s.val}</div>
              <div style="margin-top: 10px; font-size: 0.82rem; color: var(--muted); font-family: var(--font-body); font-weight: 300; line-height: 1.5;">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── WHY GUANACASTE ─────────────────────────────────────────── -->
    <section style="background: var(--card); padding: clamp(60px, 10vw, 120px) 24px;">
      <div style="max-width: 900px; margin: 0 auto; text-align: center;">
        <div class="reveal-hidden delay-0">
          <div class="eyebrow"><span class="dot"></span>Based in Nicoya · Working across Guanacaste</div>
          <h2 class="sec-heading" style="margin-top: 14px;">We know this coast like no one else.</h2>
          <p style="font-weight: 300; color: var(--muted); font-size: 1.05rem; line-height: 1.75; max-width: 680px; margin: 28px auto 0; font-family: var(--font-body);">
            We are not a San José agency doing a road trip. We live and work in Guanacaste — we know the light at sunset in Tamarindo, the real estate market in Nosara, and what resonates with both local and international audiences. Bilingual team, fast delivery, and a genuine understanding of the expat and tourist market.
          </p>
        </div>
        <div class="reveal-hidden delay-1" style="margin-top: 40px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: center;">
          <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            Message us on WhatsApp
          </a>
          <a href="/en/real-estate-photography-guanacaste" class="btn-ghost liquid-glass-strong" style="color: #fff;">Real Estate Photography →</a>
        </div>
      </div>
    </section>

    <!-- ── FAQ ────────────────────────────────────────────────────── -->
    <section style="background: var(--bg); padding: clamp(60px, 10vw, 120px) 24px;">
      <div style="max-width: 780px; margin: 0 auto;">
        <div class="reveal-hidden delay-0" style="margin-bottom: 48px; text-align: center;">
          <div class="eyebrow"><span class="dot"></span>Common questions</div>
          <h2 class="sec-heading" style="margin-top: 14px;">FAQ</h2>
        </div>
        <div style="display: flex; flex-direction: column; gap: 2px;">
          {[
            { q: 'Do you work with English-speaking clients?', a: 'Yes. We are fully bilingual and regularly work with expats, property owners, hotels, tour operators, and international businesses across Guanacaste.' },
            { q: 'Do you cover weddings in Tamarindo and Nosara?', a: 'Yes. We cover weddings, elopements, and events throughout all of Guanacaste — Tamarindo, Nosara, Sámara, Playa Flamingo, Santa Cruz, and beyond.' },
            { q: 'How much does real estate photography in Guanacaste cost?', a: 'Pricing depends on property size and whether drone video is included. Contact us via WhatsApp for a custom quote — we typically respond within a few hours.' },
            { q: 'Do you manage social media for hotels and restaurants?', a: 'Yes. We offer monthly social media management that includes strategy, content creation, reels, and community management in both English and Spanish.' },
          ].map((item) => (
            <details class="liquid-glass" style="border-radius: 0.75rem; padding: 1.5rem 1.75rem; cursor: pointer;">
              <summary style="font-family: var(--font-body); font-size: 1rem; font-weight: 500; color: var(--fg); list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                {item.q}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <p style="margin: 16px 0 0; font-weight: 300; font-size: 0.97rem; line-height: 1.7; color: var(--muted); font-family: var(--font-body);">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CtaFooter />
  </main>
</Layout>
