---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import CtaFooter from '../../components/CtaFooter.astro';

const services = [
  {
    img: 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779745654/identidad-visual_yd23y7.jpg',
    title: 'Visual Identity',
    desc: 'Logos, color palettes, and typography. We create the visual foundation that makes your business recognized and remembered.',
  },
  {
    img: 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779745829/dise%C3%B1o-ui-ux_xkpdyo.jpg',
    title: 'UI/UX Design',
    desc: 'Clean, easy-to-use interfaces. We design with the user experience in mind to increase conversions.',
  },
  {
    img: 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779745925/sistemas-de-dise%C3%B1o_sto3u0.jpg',
    title: 'Design Systems',
    desc: 'Clear rules and reusable components. Your brand maintains perfect consistency everywhere it appears online.',
  },
  {
    img: 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779746048/direccion-creativa_ckcmil.jpg',
    title: 'Creative Direction',
    desc: 'From concept to execution. We guide the aesthetic vision to ensure every piece serves the business objective.',
  },
];

const galeria = [
  {
    img: 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779746152/Moodboards_wbcdfh.jpg',
    alt: 'Moodboard',
    caption: 'Moodboards & Concepts',
  },
  {
    img: 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779746251/sistemas-de-color_dufyyw.jpg',
    alt: 'Color palettes',
    caption: 'Color Systems',
  },
  {
    img: 'https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779746313/tipografia_felx7h.jpg',
    alt: 'Typography',
    caption: 'Typography Curation',
  },
];
---
<Layout
  title="Brand Design in Guanacaste, Costa Rica | One Out Creative"
  description="Visual identity and brand design in Guanacaste, Costa Rica. We create brands that work, scale, and position your company in Nicoya, Tamarindo, Nosara, and Santa Cruz."
  lang="en"
  hreflangEs="https://oneoutcr.net/diseno-marca"
  hreflangEn="https://oneoutcr.net/en/diseno-marca"
>
  <Navbar lang="en" />
  <main id="top">

    <!-- ── HERO ─────────────────────────────────────────────────── -->
    <section class="brand-hero">
      <div class="hero-container">
        <div class="hero-content">
          <div class="reveal-hidden">
            <div class="eyebrow accent" style="margin-bottom: 24px;"><span class="dot"></span>Branding & Design · Guanacaste, CR</div>
          </div>

          <h1 class="font-heading big-title">
            <div class="reveal-hidden" style="transition-delay: 0.1s;">Design that</div>
            <div class="reveal-hidden" style="transition-delay: 0.15s; margin-left: 5vw; display: flex; align-items: center; gap: 15px;">
              <div class="title-line"></div>
              <span>elevates your</span>
            </div>
            <div class="reveal-hidden" style="transition-delay: 0.2s;">
              <span style="color: var(--accent);">business.</span>
            </div>
          </h1>

          <div class="reveal-hidden hero-subtext" style="transition-delay: 0.3s;">
            <p>
              Your visual identity is the first trust filter. We create solid brands in Guanacaste that convey quality, position your company, and separate you from the competition in Nicoya, Tamarindo, and Nosara.
            </p>
          </div>
        </div>

        <div class="hero-visual">
          <div class="reveal-hidden visual-img img-1" style="transition-delay: 0.2s;">
            <img src="https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_800/v1779746540/marca_r85ztz.jpg" alt="Brand design box" fetchpriority="high" decoding="sync" />
          </div>
          <div class="reveal-hidden visual-img img-2" style="transition-delay: 0.3s;">
            <img src="https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_600/v1779746698/branding-abstracto_nfn6ct.jpg" alt="Abstract branding" fetchpriority="high" decoding="sync" />
          </div>
        </div>
      </div>
    </section>

    <!-- ── MANIFESTO MARQUEE ──────────────────────────────────── -->
    <section class="manifesto-wrap">
      <div class="reveal-hidden" style="transition-delay: 0.1s;">
        <h2 class="font-heading manifesto-text">
          Less noise. <span style="color: transparent; -webkit-text-stroke: 1px var(--fg);">More intention.</span>
          We connect strategy <span style="color: transparent; -webkit-text-stroke: 1px var(--accent);">with aesthetics.</span>
        </h2>
      </div>
    </section>

    <!-- ── SERVICES BENTO ──────────────────────────────────────── -->
    <section class="services-section">
      <div class="services-container">
        <div class="reveal-hidden" style="margin-bottom: 48px;">
          <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1; margin: 0; text-transform: uppercase;">
            Our specialties
          </h2>
        </div>

        <div class="bento-grid">
          {services.map((srv, i) => (
            <div class={`reveal-hidden bento-card bento-${i}`} style={`transition-delay: ${(i * 0.1) + 0.1}s;`}>
              <div class="bento-img-wrap">
                <img src={srv.img} alt={srv.title} class="bento-img" loading="lazy" decoding="async" />
                <div class="bento-overlay"></div>
              </div>
              <div class="bento-content">
                <span class="font-heading bento-num">0{i + 1}</span>
                <h3 class="font-heading bento-title">{srv.title}</h3>
                <p class="bento-desc">{srv.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── GALLERY ─────────────────────────────────────────────── -->
    <section class="gallery-section">
      <div class="gallery-grid">
        {galeria.map((item, i) => (
          <div
            class="reveal-hidden gal-item"
            style={`transition-delay: ${(i + 1) * 0.1}s;${i === 1 ? ' margin-top: 10%;' : ''}`}
          >
            <img src={item.img} alt={item.alt} loading="lazy" decoding="async" />
            <p class="font-heading gal-caption">{item.caption}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── FINAL CTA ────────────────────────────────────────────── -->
    <section style="background: var(--card); padding: clamp(80px, 12vw, 130px) 24px; position: relative; overflow: hidden;">
      <div class="cta-glow"></div>
      <div style="max-width: 1000px; margin: 0 auto; text-align: center; position: relative; z-index: 2;">
        <div class="reveal-hidden">
          <div class="eyebrow accent" style="margin-bottom: 24px; justify-content: center;"><span class="dot"></span>Bring your brand to life</div>
        </div>
        <div class="reveal-hidden" style="transition-delay: 0.1s;">
          <h2 class="font-heading" style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 0.95; text-transform: uppercase; margin: 0 0 24px;">
            Design isn't an expense.<br />It's a <span style="color: var(--accent);">visible investment.</span>
          </h2>
        </div>
        <div class="reveal-hidden" style="transition-delay: 0.2s;">
          <p style="font-size: 1.1rem; color: var(--muted); font-weight: 300; max-width: 600px; margin: 0 auto 40px; line-height: 1.6;">
            If you think it's time to elevate your business's perception and compete at the highest level, let's talk about how we can help you.
          </p>
          <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding: 1.1rem 2.4rem; font-size: 0.9rem;">
            Start your brand project
          </a>
        </div>
      </div>
    </section>

    <CtaFooter lang="en" />
  </main>
</Layout>

<style>
  .brand-hero {
    padding: clamp(120px, 15vw, 180px) 24px clamp(60px, 10vw, 100px);
    background: var(--bg);
    overflow: hidden;
  }
  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .big-title {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--fg);
    margin: 0;
  }
  .title-line {
    height: 6px;
    width: clamp(40px, 8vw, 100px);
    background-color: var(--fg);
  }

  .hero-subtext {
    margin-top: 40px;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.7;
    color: var(--muted);
    font-weight: 300;
    max-width: 480px;
  }

  .hero-visual {
    position: relative;
    min-height: 500px;
  }
  .visual-img {
    position: absolute;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }
  .visual-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    will-change: transform;
  }
  .visual-img:hover img {
    transform: scale(1.05);
  }
  .img-1 {
    width: 75%;
    aspect-ratio: 4/5;
    top: 0;
    right: 0;
    z-index: 1;
  }
  .img-2 {
    width: 55%;
    aspect-ratio: 1/1;
    bottom: 20px;
    left: -10%;
    z-index: 2;
    border: 4px solid var(--bg);
  }

  .manifesto-wrap {
    padding: clamp(60px, 10vw, 100px) 24px;
    background: var(--bg);
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    text-align: center;
  }
  .manifesto-text {
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0 auto;
    max-width: 1100px;
    text-wrap: balance;
  }

  .services-section {
    padding: clamp(80px, 12vw, 140px) 24px;
    background: var(--bg);
  }
  .services-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(300px, auto);
    }
    .bento-0, .bento-3 { grid-column: span 2; min-height: 400px; }
  }

  .bento-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--card);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 350px;
    padding: 32px;
  }
  .bento-img-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bento-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }
  .bento-card:hover .bento-img {
    transform: scale(1.08);
  }
  .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.4) 50%, transparent 100%);
  }

  .bento-content {
    position: relative;
    z-index: 1;
  }
  .bento-num {
    display: block;
    font-size: 1.25rem;
    color: var(--accent);
    margin-bottom: 8px;
    opacity: 0.8;
  }
  .bento-title {
    font-size: clamp(2rem, 3vw, 2.5rem);
    text-transform: uppercase;
    margin: 0 0 12px;
    line-height: 1;
  }
  .bento-desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.6;
    margin: 0;
    max-width: 400px;
    font-weight: 300;
  }

  .gallery-section {
    padding: clamp(40px, 8vw, 80px) 24px clamp(80px, 12vw, 140px);
    background: var(--bg);
  }
  .gallery-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .gal-item {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gal-item img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: 8px;
    filter: grayscale(20%);
    transition: filter 0.4s ease;
  }
  .gal-item:hover img {
    filter: grayscale(0%);
  }
  .gal-caption {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .cta-glow {
    position: absolute;
    top: -50%; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(232,119,34,0.15) 0%, transparent 60%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }
</style>
