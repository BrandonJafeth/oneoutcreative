---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import CtaFooter from '../../components/CtaFooter.astro';

const servicios = [
  {
    n: '01',
    titulo: 'Digital Strategy',
    desc: 'Before publishing a single post, we analyze market, competition, and audience. Every action has a real purpose behind it.',
    tags: ['Audit', 'Buyer Persona', '90-Day Roadmap'],
  },
  {
    n: '02',
    titulo: 'Content & Copywriting',
    desc: 'Words that convert. Design that stops the scroll. Visual pieces and copy that speak directly to your ideal customer.',
    tags: ['Social Media', 'Blogs', 'Email Sequences'],
  },
  {
    n: '03',
    titulo: 'Paid Media',
    desc: 'Optimized investment where it matters. Meta Ads and Google Ads measured by cost-per-result, not empty clicks.',
    tags: ['Meta Ads', 'Google Ads', 'Retargeting'],
  },
  {
    n: '04',
    titulo: 'Analytics & Reports',
    desc: 'No vanity metrics. Clear reports with what matters: leads, conversions, and real return on investment.',
    tags: ['GA4', 'Dashboards', 'ROI Tracking'],
  },
];

const antes = [
  { label: 'Monthly reach',     val: '320 people' },
  { label: 'Cost per lead',     val: '$48 USD' },
  { label: 'Conversion rate',   val: '0.8%' },
  { label: 'Average ROAS',      val: '1.2x' },
];

const despues = [
  { label: 'Monthly reach',     val: '+18,400' },
  { label: 'Cost per lead',     val: '$6.20 USD' },
  { label: 'Conversion rate',   val: '4.7%' },
  { label: 'Average ROAS',      val: '5.8x' },
];
---
<Layout
  title="Digital Marketing in Guanacaste, Costa Rica | One Out Creative"
  description="Strategy, social media, Meta Ads and Google Ads in Guanacaste, Costa Rica. Marketing agency in Nicoya, Tamarindo and Nosara. We turn your investment into real customers."
  lang="en"
  hreflangEs="https://oneoutcr.net/marketing"
  hreflangEn="https://oneoutcr.net/en/marketing"
>
  <Navbar lang="en" />
  <main id="top">

    <!-- ── HERO ──────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-bg-num" aria-hidden="true">ROI</div>

      <div class="hero-inner">

        <div class="hero-text">
          <div class="reveal-hidden">
            <div class="eyebrow accent" style="margin-bottom: 28px;">
              <span class="dot"></span>Digital Marketing · Guanacaste, CR
            </div>
          </div>
          <div class="reveal-hidden" style="transition-delay: 0.1s;">
            <h1 class="font-heading hero-h1">
              Marketing<br />
              that sells.<br />
              <span class="accent-stroke">Not just<br />looks good.</span>
            </h1>
          </div>
          <div class="reveal-hidden" style="transition-delay: 0.22s; margin-top: 28px;">
            <p class="hero-sub">
              Marketing agency in Guanacaste, Costa Rica. We combine strategy, content, and paid ads to reach more customers in Nicoya, Tamarindo, Nosara, and Santa Cruz.
            </p>
          </div>
          <div class="reveal-hidden hero-btns" style="transition-delay: 0.34s; margin-top: 36px;">
            <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding: 0.9rem 1.9rem; font-size: 0.82rem;">
              I want more customers
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>
            <a href="#servicios" class="btn-ghost liquid-glass-strong" style="padding: 0.9rem 1.9rem; font-size: 0.82rem;">
              See services
            </a>
          </div>
        </div>

        <div class="hero-right">
          <div class="hero-glow" aria-hidden="true"></div>
          <div class="hero-grid" aria-hidden="true"></div>

          <div class="reveal-hidden campaign-wrap" style="transition-delay: 0.2s;">
            <div class="campaign-card liquid-glass-strong">
              <div class="cc-header">
                <div class="cc-platform">
                  <div class="cc-dot" style="background: #1877f2;"></div>
                  <span>Meta Ads Manager</span>
                </div>
                <div class="cc-live">
                  <div class="cc-live-dot"></div>
                  <span>Live</span>
                </div>
              </div>

              <div class="cc-kpi-row">
                <div class="cc-kpi">
                  <div class="cc-kpi-label">Investment</div>
                  <div class="cc-kpi-val font-heading">$840</div>
                </div>
                <div class="cc-kpi">
                  <div class="cc-kpi-label">Results</div>
                  <div class="cc-kpi-val font-heading cc-green">128</div>
                </div>
                <div class="cc-kpi">
                  <div class="cc-kpi-label">Cost / result</div>
                  <div class="cc-kpi-val font-heading">$6.56</div>
                </div>
              </div>

              <div class="cc-chart" aria-hidden="true">
                <div class="cc-chart-bars">
                  {[30, 45, 38, 62, 55, 70, 58, 80, 75, 88, 72, 95, 85, 100].map((h) => (
                    <div class="cc-bar" style={`height: ${h}%`}></div>
                  ))}
                </div>
                <div class="cc-chart-label">Last 2 weeks</div>
              </div>

              <div class="cc-footer">
                <div class="cc-trend">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                  <span style="color: #22c55e;">+62%</span>
                  <span style="color: var(--soft-text);">vs last month</span>
                </div>
                <div class="cc-ctr">CTR <strong>4.7%</strong></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── TICKER ─────────────────────────────────────────────────── -->
    <div class="ticker-wrap" aria-hidden="true">
      <div class="ticker-track">
        {Array(3).fill(['STRATEGY', 'CONTENT', 'META ADS', 'GOOGLE ADS', 'EMAIL MARKETING', 'SEO', 'CONVERSION', 'ANALYTICS', 'ROI', 'RETARGETING']).flat().map((t) => (
          <span class="ticker-item font-heading">{t}<span class="ticker-dot">·</span></span>
        ))}
      </div>
    </div>

    <!-- ── SERVICES ──────────────────────────────────────────────── -->
    <section id="servicios" style="background: var(--card); padding: clamp(80px, 12vw, 130px) 24px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div class="reveal-hidden" style="margin-bottom: 8px;">
          <div class="eyebrow"><span class="dot"></span>What we do</div>
        </div>
        <div class="reveal-hidden" style="margin-bottom: 56px; transition-delay: 0.05s;">
          <h2 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 4rem); line-height: 0.95; text-transform: uppercase; margin: 0; text-wrap: balance;">
            Everything under one<br /><span style="color: var(--accent);">strategic roof.</span>
          </h2>
        </div>

        {servicios.map((s, i) => (
          <div class="reveal-hidden srv-row" style={`transition-delay: ${i * 0.08}s;`}>
            <div class="srv-num font-heading">{s.n}</div>
            <div class="srv-body">
              <h3 class="font-heading srv-titulo">{s.titulo}</h3>
              <p class="srv-desc">{s.desc}</p>
              <div class="srv-tags">
                {s.tags.map((t) => <span class="srv-tag">{t}</span>)}
              </div>
            </div>
            <div class="srv-arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </div>
          </div>
        ))}
        <div style="border-top: 1px solid var(--hairline);"></div>
      </div>
    </section>

    <!-- ── BEFORE vs AFTER ───────────────────────────────────────── -->
    <section style="background: var(--bg); padding: clamp(80px, 12vw, 130px) 24px; overflow: hidden;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div class="reveal-hidden" style="text-align: center; margin-bottom: 16px;">
          <div class="eyebrow" style="justify-content: center;"><span class="dot"></span>Real results</div>
        </div>
        <div class="reveal-hidden" style="text-align: center; margin-bottom: 60px; transition-delay: 0.06s;">
          <h2 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 4rem); line-height: 0.95; text-transform: uppercase; margin: 0;">
            Numbers that<br /><span style="color: var(--accent);">don't lie.</span>
          </h2>
        </div>

        <div class="comparison-grid">
          <div class="reveal-hidden comparison-col before-col" style="transition-delay: 0.1s;">
            <div class="col-header">
              <span class="col-badge before-badge">Without strategic marketing</span>
            </div>
            {antes.map((row) => (
              <div class="comp-row before-row">
                <span class="comp-label">{row.label}</span>
                <span class="comp-val before-val">{row.val}</span>
              </div>
            ))}
          </div>

          <div class="reveal-hidden comparison-divider" style="transition-delay: 0.15s;" aria-hidden="true">
            <div class="div-line"></div>
            <div class="div-pill font-heading">VS</div>
            <div class="div-line"></div>
          </div>

          <div class="reveal-hidden comparison-col after-col" style="transition-delay: 0.2s;">
            <div class="col-header">
              <span class="col-badge after-badge">With One Out Creative</span>
            </div>
            {despues.map((row) => (
              <div class="comp-row after-row">
                <span class="comp-label">{row.label}</span>
                <span class="comp-val after-val">{row.val}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal-hidden" style="text-align: center; margin-top: 48px;">
          <p style="font-size: 0.75rem; color: var(--soft-text); letter-spacing: 0.1em; text-transform: uppercase;">
            Example based on a real client in the services sector · Individual results may vary
          </p>
        </div>
      </div>
    </section>

    <!-- ── CAMPAIGN GALLERY ─────────────────────────────────────── -->
    <section style="background: var(--card); padding: clamp(80px, 12vw, 130px) 24px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div class="reveal-hidden" style="margin-bottom: 8px;">
          <div class="eyebrow"><span class="dot"></span>Recent campaigns</div>
        </div>
        <div class="reveal-hidden" style="margin-bottom: 48px; transition-delay: 0.05s;">
          <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 3.2rem); line-height: 0.95; text-transform: uppercase; margin: 0;">
            The work speaks<br /><span style="color: var(--accent);">for itself.</span>
          </h2>
        </div>

        <div class="gallery-grid">
          <div class="reveal-hidden gal-card" style="transition-delay: 0.05s;">
            <img src="https://images.pexels.com/photos/3786157/pexels-photo-3786157.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" alt="Health Sector Campaign" class="gal-img" loading="lazy" width="16" height="9" />
            <div class="gal-img-overlay"></div>
            <div class="gal-placeholder">
              <span class="gal-ph-label font-heading">Campaign · Health Sector</span>
              <span class="gal-ph-meta">+340% leads · 3 months</span>
            </div>
            <div class="gal-overlay">
              <div class="gal-tag">Meta Ads + Content</div>
            </div>
          </div>

          <div class="reveal-hidden gal-card" style="transition-delay: 0.1s;">
            <img src="https://images.pexels.com/photos/5632398/pexels-photo-5632398.jpeg?auto=compress&cs=tinysrgb&w=800&h=1000&dpr=1" alt="E-commerce Campaign" class="gal-img" loading="lazy" width="4" height="5" />
            <div class="gal-img-overlay"></div>
            <div class="gal-placeholder">
              <span class="gal-ph-label font-heading">Campaign · E-commerce</span>
              <span class="gal-ph-meta">ROAS 6.2x</span>
            </div>
            <div class="gal-overlay">
              <div class="gal-tag">Google Shopping</div>
            </div>
          </div>

          <div class="reveal-hidden gal-card" style="transition-delay: 0.15s;">
            <img src="https://images.pexels.com/photos/1126728/pexels-photo-1126728.jpeg?auto=compress&cs=tinysrgb&w=800&h=1000&dpr=1" alt="Restaurant Campaign" class="gal-img" loading="lazy" width="4" height="5" />
            <div class="gal-img-overlay"></div>
            <div class="gal-placeholder">
              <span class="gal-ph-label font-heading">Campaign · Restaurant</span>
              <span class="gal-ph-meta">+180% reservations</span>
            </div>
            <div class="gal-overlay">
              <div class="gal-tag">Instagram Ads</div>
            </div>
          </div>

          <div class="reveal-hidden gal-card" style="transition-delay: 0.2s;">
            <img src="https://images.pexels.com/photos/106399/pexels-photo-106399.jpeg?auto=compress&cs=tinysrgb&w=800&h=1000&dpr=1" alt="Real Estate Campaign" class="gal-img" loading="lazy" width="4" height="5" />
            <div class="gal-img-overlay"></div>
            <div class="gal-placeholder">
              <span class="gal-ph-label font-heading">Campaign · Real Estate</span>
              <span class="gal-ph-meta">Cost/lead -74%</span>
            </div>
            <div class="gal-overlay">
              <div class="gal-tag">Meta Leads</div>
            </div>
          </div>

          <div class="reveal-hidden gal-card" style="transition-delay: 0.25s;">
            <img src="https://images.pexels.com/photos/4145153/pexels-photo-4145153.jpeg?auto=compress&cs=tinysrgb&w=800&h=1000&dpr=1" alt="Education Campaign" class="gal-img" loading="lazy" width="4" height="5" />
            <div class="gal-img-overlay"></div>
            <div class="gal-placeholder">
              <span class="gal-ph-label font-heading">Campaign · Education</span>
              <span class="gal-ph-meta">4,200 enrollments</span>
            </div>
            <div class="gal-overlay">
              <div class="gal-tag">Full Funnel</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
    <section class="cta-section">
      <div class="cta-glow-left" aria-hidden="true"></div>
      <div class="cta-glow-right" aria-hidden="true"></div>
      <div class="cta-inner">
        <div class="reveal-hidden">
          <div class="eyebrow accent" style="justify-content: center; margin-bottom: 24px;">
            <span class="dot"></span>Ready to grow?
          </div>
        </div>
        <div class="reveal-hidden" style="transition-delay: 0.1s;">
          <h2 class="font-heading cta-h2">
            Your competition<br />is already investing<br />
            <span style="color: var(--accent);">in marketing.</span>
          </h2>
        </div>
        <div class="reveal-hidden" style="transition-delay: 0.2s;">
          <p class="cta-sub">
            Every day without a digital strategy is an opportunity someone else takes. Let's talk today — the first session is free.
          </p>
        </div>
        <div class="reveal-hidden cta-btns" style="transition-delay: 0.3s;">
          <a href="https://wa.me/50689000108" target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding: 1.1rem 2.4rem; font-size: 0.85rem;">
            Book a free consultation
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        </div>
      </div>
    </section>

    <CtaFooter lang="en" />
  </main>
</Layout>


<style>
  .hero {
    position: relative;
    background: var(--bg);
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: stretch;
  }

  .hero-bg-num {
    position: absolute;
    top: 50%;
    left: -2%;
    transform: translateY(-50%);
    font-family: var(--font-heading);
    font-size: clamp(18vw, 28vw, 380px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.03);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    letter-spacing: -0.04em;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    gap: 0;
    align-items: center;
    min-height: 100svh;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 3fr 2fr; gap: 48px; }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(100px, 12vh, 150px) 0 clamp(28px, 4vh, 48px);
    align-items: center;
    text-align: center;
  }
  @media (min-width: 900px) {
    .hero-text {
      padding: clamp(120px, 14vh, 170px) 0 clamp(120px, 14vh, 170px) 0;
      align-items: flex-start;
      text-align: left;
    }
  }

  .hero-h1 {
    font-size: clamp(3rem, 14vw, 6.4rem);
    line-height: 0.9;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--fg);
    margin: 0;
    width: 100%;
  }

  .accent-stroke {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--muted);
    max-width: 460px;
  }

  .hero-btns {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .hero-btns a {
    justify-content: center;
    text-align: center;
  }
  @media (min-width: 480px) {
    .hero-btns {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
    .hero-btns a {
      justify-content: initial;
      text-align: initial;
    }
  }

  .hero-right {
    display: none;
  }
  @media (min-width: 900px) {
    .hero-right {
      display: flex;
      position: relative;
      align-items: center;
      justify-content: center;
      min-height: auto;
      padding: 80px 0;
    }
  }

  .hero-glow {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 420px; height: 420px; border-radius: 9999px;
    background: radial-gradient(ellipse, rgba(232,119,34,0.12), transparent 65%);
    filter: blur(60px); pointer-events: none;
  }
  .hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  }

  .campaign-wrap {
    position: relative;
    width: 100%;
    max-width: min(420px, 100%);
    z-index: 2;
  }

  .campaign-card {
    border-radius: 16px;
    border: 1px solid var(--hairline);
    background: rgba(22, 22, 22, 0.9);
    padding: clamp(14px, 3vw, 20px);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04) inset,
      0 40px 100px rgba(0,0,0,0.55),
      0 8px 24px rgba(0,0,0,0.35);
  }

  .cc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }
  .cc-platform {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.05em;
  }
  .cc-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }
  .cc-live {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 600;
    color: #22c55e;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cc-live-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .cc-kpi-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }
  .cc-kpi-label {
    font-family: var(--font-body);
    font-size: 0.58rem;
    color: var(--soft-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .cc-kpi-val {
    font-size: clamp(1.1rem, 3.5vw, 1.4rem);
    color: var(--fg);
    line-height: 1;
  }
  .cc-green { color: #22c55e; }

  .cc-chart {
    margin-bottom: 16px;
  }
  .cc-chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 56px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--hairline);
  }
  .cc-bar {
    flex: 1;
    background: linear-gradient(to top, var(--accent), rgba(232,119,34,0.3));
    border-radius: 2px 2px 0 0;
    min-height: 4px;
  }
  .cc-chart-label {
    font-family: var(--font-body);
    font-size: 0.58rem;
    color: var(--soft-text);
    letter-spacing: 0.06em;
    margin-top: 6px;
  }

  .cc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cc-trend {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
  }
  .cc-ctr {
    font-family: var(--font-body);
    font-size: 0.65rem;
    color: var(--soft-text);
    letter-spacing: 0.06em;
  }
  .cc-ctr strong {
    color: var(--fg);
    font-weight: 600;
  }

  .ticker-wrap {
    overflow: hidden;
    white-space: nowrap;
    padding: 18px 0;
    background: var(--accent);
    position: relative;
  }
  .ticker-track {
    display: inline-block;
    animation: ticker 35s linear infinite;
  }
  .ticker-item {
