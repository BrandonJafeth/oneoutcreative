---
import items from '../data/clientes.json';
const looped = [...items, ...items, ...items, ...items];
---
<section style="background: var(--bg); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); padding: 24px 0;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px; text-align: center; margin-bottom: 20px;">
    <div class="reveal-hidden" style="transition-delay: 0s;">
      <div class="eyebrow"><span class="dot"></span>Clientes</div>
    </div>
    <div class="reveal-hidden" style="transition-delay: 0.15s;">
      <h2 class="sec-heading" style="margin-top: 20px;">Empresas que confían en nuestro trabajo</h2>
    </div>
  </div>

  <div class="reveal-hidden" style="transition-delay: 0.3s;">
    <div class="marquee-wrapper">
      <div class="marquee-track" style="animation-duration: 22s;">
        {looped.map((it) => (
          <span style="display: inline-flex; align-items: center; gap: 4rem; white-space: nowrap;">
            <img
              src={it.logo}
              alt={it.name}
              height="64"
              style="height: 64px; width: auto; max-width: 200px; object-fit: contain; opacity: 0.8; transition: opacity 0.3s;"
              onmouseover="this.style.opacity='1'"
              onmouseout="this.style.opacity='0.8'"
              loading="lazy"
              decoding="async"
            />
            <span style="color: var(--hairline-strong); font-size: 0.6rem; flex-shrink: 0;">|</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
