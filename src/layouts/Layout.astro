---
import '../styles/global.css';
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  title?: string;
  description?: string;
  schema?: string;
}
const {
  title = 'One Out Creative | Marketing Digital en San José, Costa Rica',
  description = 'Agencia de marketing digital en San José, Costa Rica. Fotos, videos, redes sociales y diseño de marca que hacen crecer tu negocio.',
  schema,
} = Astro.props;

const orgSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": "https://oneoutcr.net/#organization",
      "name": "One Out Creative",
      "url": "https://oneoutcr.net/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://res.cloudinary.com/dkwvaxxdw/image/upload/c_pad,b_rgb:e87722,w_512,h_512,f_png,q_auto/v1779290752/Logo_blanco_1_kintyq.png",
        "width": 512,
        "height": 512
      },
      "description": "Agencia de marketing, publicidad, fotos y videos, redes sociales, sistemas web y diseño de marca en San José, Costa Rica. Clientes: Banco Nacional, REMAX Eco, Asobeiro, Nosara Lab, Emy Asociados, Pekenitos, Laboratorio Clínico Esquípulas, Blanco Largo.",
      "knowsAbout": [
        "Marketing Digital",
        "Producción Audiovisual",
        "Fotografía Comercial",
        "Diseño de Marca",
        "Identidad Visual",
        "Desarrollo Web",
        "Redes Sociales",
        "Meta Ads",
        "Google Ads",
        "Publicidad Digital"
      ],
      "telephone": "+50689000108",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. 10, Catedral",
        "addressLocality": "San José",
        "addressRegion": "San José",
        "postalCode": "10104",
        "addressCountry": "CR"
      },
      "areaServed": { "@type": "Country", "name": "Costa Rica" },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+50689000108",
        "contactType": "customer service",
        "availableLanguage": "Spanish"
      },
      "sameAs": ["https://www.instagram.com/one.out_/"]
    },
    {
      "@type": "WebSite",
      "@id": "https://oneoutcr.net/#website",
      "url": "https://oneoutcr.net/",
      "name": "One Out Creative",
      "publisher": { "@id": "https://oneoutcr.net/#organization" },
      "inLanguage": "es-CR"
    }
  ]
});
---
<!DOCTYPE html>
<html lang="es-CR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="geo.region" content="CR-SJ" />
  <meta name="geo.placename" content="San José, Costa Rica" />
  <meta name="theme-color" content="#0a0a0a" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_1200/v1779291512/pexels-silverkblack-36697542_gbzfwm.jpg" />
  <meta property="og:locale" content="es_CR" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://images.pexels.com" />
  <link rel="preload" as="image" href="https://res.cloudinary.com/dkwvaxxdw/image/upload/f_auto,q_auto,w_1920/v1779291512/pexels-silverkblack-36697542_gbzfwm.jpg" fetchpriority="high" />
  <link rel="icon" type="image/png" sizes="32x32" href="https://res.cloudinary.com/dkwvaxxdw/image/upload/c_pad,b_rgb:e87722,w_32,h_32,f_png,q_auto/v1779290752/Logo_blanco_1_kintyq.png" />
  <link rel="icon" type="image/png" sizes="64x64" href="https://res.cloudinary.com/dkwvaxxdw/image/upload/c_pad,b_rgb:e87722,w_64,h_64,f_png,q_auto/v1779290752/Logo_blanco_1_kintyq.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="https://res.cloudinary.com/dkwvaxxdw/image/upload/c_pad,b_rgb:e87722,w_180,h_180,f_png,q_auto/v1779290752/Logo_blanco_1_kintyq.png" />
  <title>{title}</title>
  <script is:inline type="application/ld+json" set:html={orgSchema} />
  {schema && <script is:inline type="application/ld+json" set:html={schema} />}
</head>
<body class="bg-background text-foreground antialiased">
  <CustomCursor />
  <slot />
</body>
</html>

<script>
  // data-animate: secciones con is-visible (index page)
  const animateObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      });
    },
    { threshold: 0.1, rootMargin: '-80px' }
  );
  document.querySelectorAll('[data-animate]').forEach((el) => animateObserver.observe(el));

  // reveal-hidden: fade-up reveal usado en páginas de servicio
  const revealObserver = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
          entry.target.classList.remove('reveal-hidden');
          const imgWrap = entry.target.querySelector('.service-image-wrap');
          if (imgWrap) imgWrap.classList.add('in-view');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal-hidden').forEach((el) => revealObserver.observe(el));
</script>
